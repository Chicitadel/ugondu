{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugondu.io/schemas/qualification-evidence.schema.json",
  "title": "Ugondu Qualification Evidence Record Schema",
  "description": "Strict schema for per-gate and per-target qualification evidence records required by UGONDU_COR_REAUDIT_REMEDIATION_PLAN.md Section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "executionId",
    "gateId",
    "status",
    "source",
    "target",
    "startedAt",
    "completedAt",
    "command",
    "exitCode",
    "rawLogSha256",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 8
    },
    "executionId": {
      "type": "string",
      "minLength": 8
    },
    "gateId": {
      "type": "string",
      "pattern": "^COR-[A-Z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "UNQUALIFIED", "NOT_COLLECTED"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "workflowRunId"],
      "properties": {
        "repository": {
          "type": "string",
          "const": "Chicitadel/ugondu"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflowRunId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "runtime", "provider", "mode"],
      "properties": {
        "os": {
          "type": "string",
          "enum": ["linux", "darwin", "windows", "win32"]
        },
        "architecture": {
          "type": "string",
          "enum": ["amd64", "x64", "arm64"]
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "human-ui",
            "human-cli",
            "ide",
            "model-assisted",
            "non-model",
            "automation",
            "headless-ci"
          ]
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exitCode": {
      "type": "integer"
    },
    "rawLogSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
