{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policies.airroofers.eu/schemas/ugondu/bootstrap/policy-pack.schema.json",
  "title": "Ugondu Plan-Bound Policy Pack",
  "type": "object",
  "required": [
    "policy_pack_id",
    "version",
    "provider",
    "capability_ids",
    "role_id",
    "target_scope",
    "plan_digest",
    "generated_at",
    "policy_documents",
    "validation_receipts",
    "approval_requirements",
    "rollback_strategy",
    "expires_at_or_session_limit"
  ],
  "properties": {
    "policy_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "target_scope": {
      "type": "object",
      "required": [
        "environment",
        "resource_families",
        "operation_ids"
      ],
      "properties": {
        "tenant_or_account_or_project": {
          "type": "string",
          "minLength": 1
        },
        "partition_or_cloud": {
          "type": "string",
          "minLength": 1
        },
        "region_or_location": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "resource_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resource_names_or_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "identity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network_or_namespace_scope_when_applicable": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at_or_session_limit": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "policy_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "format",
          "document"
        ],
        "properties": {
          "format": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": [
              "object",
              "array",
              "string"
            ]
          },
          "digest": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "validation_receipts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rollback_strategy": {
      "type": "object"
    },
    "approval_record": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
