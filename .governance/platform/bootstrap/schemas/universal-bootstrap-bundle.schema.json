{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policies.airroofers.eu/schemas/ugondu/bootstrap/universal-bootstrap-bundle.schema.json",
  "title": "Ugondu Universal Bootstrap Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "task_id",
    "status",
    "entrypoints",
    "required_package_contents",
    "bundle_invariants",
    "execution_order",
    "required_runtime_outputs",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_id": {
      "const": "ugondu.universal-bootstrap.bundle"
    },
    "task_id": {
      "const": "UG-UPLM-BOOTSTRAP-UNIVERSAL-001"
    },
    "status": {
      "type": "string"
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1
    },
    "required_package_contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "required",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "bundle_invariants": {
      "type": "object",
      "required": [
        "fail_closed",
        "unknown_or_missing_artifact_is_fatal",
        "runtime_permissions_must_not_exceed_approved_plan"
      ],
      "properties": {
        "fail_closed": {
          "const": true
        },
        "unknown_or_missing_artifact_is_fatal": {
          "const": true
        },
        "runtime_permissions_must_not_exceed_approved_plan": {
          "const": true
        }
      }
    },
    "execution_order": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "required_runtime_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
