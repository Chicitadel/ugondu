{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EAORCS Change Control Declaration Schema",
  "description": "Schema defining machine-readable authorized-change declarations required by UAIGOS 3.0.0 governance.",
  "type": "object",
  "required": [
    "changeTicketId",
    "governanceModel",
    "author",
    "reason",
    "targetFiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "changeTicketId": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "governanceModel": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "targetFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "filePath",
          "requirementRef",
          "invariant",
          "regressionTest",
          "rollbackBoundary"
        ],
        "properties": {
          "filePath": {
            "type": "string"
          },
          "requirementRef": {
            "type": "string"
          },
          "invariant": {
            "type": "string"
          },
          "regressionTest": {
            "type": "string"
          },
          "rollbackBoundary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}