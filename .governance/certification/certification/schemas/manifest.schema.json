{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Manifest",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "type": "string"
    },
    "evidenceSchema": {
      "type": "string"
    },
    "platformVersion": {
      "type": "string"
    },
    "governanceVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatorVersion": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    }
  },
  "required": [
    "manifestVersion",
    "evidenceSchema",
    "platformVersion",
    "generatedAt",
    "evidence"
  ]
}