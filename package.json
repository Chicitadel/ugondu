{
  "name": "@airroofers/ugondu-platform",
  "version": "1.0.0",
  "description": "[en] Ugondu Universal Deployment Intelligence Platform — Air Roofers Commercial Product",
  "private": true,
  "author": "Ujomor Systems Engineering & Governance Authority",
  "license": "UNLICENSED",
  "workspaces": [
    "server/shared",
    "server/engine-core",
    "server/billing-gateway",
    "server/plugin-manager",
    "server/event-bus",
    "server/repository-adapter",
    "server/uppie",
    "server/capabilities",
    "server/tests"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:contract": "node tests/schema-validation.test.js && node tests/uplm-conformance.test.js",
    "test:integration": "node tests/billing-gateway.test.js && node tests/engine-core.test.js && node tests/plugin-manager.test.js && node tests/event-bus.test.js && node tests/repository-adapter.test.js && node tests/cor-remediation.test.js && node tests/language-packs.test.js && node tests/ai-inference-gateway.test.js && node tests/uplm-conformance.test.js",
    "test:e2e": "npm --workspace=server/tests run test",
    "test:security": "node tests/security-regression.test.js && node tests/ssrf-execution.test.js && node tests/passport-cryptography.test.js",
    "test:policy-pack-boundary": "node --test tests/policy-pack-path-containment.test.mjs",
    "test:bootstrap-fail-closed": "node --test tests/qualification/bootstrap-fail-closed.test.mjs tests/bootstrap-bundle-integrity.test.mjs",
    "test:compatibility": "node tests/language-packs.test.js && node tests/provider-compilation.test.js",
    "test:locales": "node scripts/validate-locales.js",
    "test:aws": "node scripts/run-cor-gates.js",
    "governance:validate": "node scripts/verify-release-integrity.js && npm run verify:attribution && npm run verify:t03 && npm run build && npm run verify:t04 && node scripts/governance/validate-repository.mjs && node scripts/governance/validate-capability-registry.mjs && node scripts/governance/validate-test-coverage.mjs && npm run test:policy-pack-boundary && npm run test:bootstrap-fail-closed && node scripts/governance/verify-policy-pack-digests.mjs && npm run test:governance",
    "start:engine": "cd server/engine-core && node dist/index.js",
    "start:billing": "cd server/billing-gateway && node dist/index.js",
    "start:plugins": "cd server/plugin-manager && node dist/index.js",
    "start:bus": "cd server/event-bus && node dist/index.js",
    "start:repo": "cd server/repository-adapter && node dist/index.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "verify:release-integrity": "node scripts/verify-release-integrity.js",
    "verify:attribution": "node scripts/governance/verify-ai-attribution.mjs",
    "verify:t03": "node scripts/governance/verify-tokenization-t03.mjs",
    "verify:t04": "node scripts/governance/verify-microservices-t04.mjs",
    "test:governance": "node --test tests/governance-verifiers.test.mjs",
    "bootstrap:validate": "node scripts/bootstrap/validate-bundle.mjs",
    "bootstrap:validate:strict": "node scripts/bootstrap/validate-bundle.mjs --strict",
    "test:bootstrap-bundle": "node --test tests/bootstrap-bundle-integrity.test.mjs",
    "bootstrap:gcp": "node scripts/bootstrap/gcp-one-step-bootstrap.mjs",
    "test:bootstrap:gcp": "node --test tests/gcp-one-step-bootstrap.test.mjs",
    "test:aws-physical-opt-in": "node --test tests/qualification/aws-physical-opt-in-contract.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1147.0",
    "@aws-sdk/client-ec2": "^3.1147.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0"
  }
}
