{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowRegionIndependentSSM",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters"
            ],
            "Resource": "arn:aws:ssm:*::parameter/aws/service/ami-amazon-linux-latest/*"
        },
        {
            "Sid": "EnforceCreationTagsForNewResources",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateVpc",
                "ec2:CreateSubnet",
                "ec2:CreateInternetGateway",
                "ec2:CreateRouteTable",
                "ec2:CreateSecurityGroup",
                "ec2:RunInstances",
                "ec2:CreateSnapshot"
            ],
            "Resource": [
                "arn:aws:ec2:eu-west-3:971671216490:vpc/*",
                "arn:aws:ec2:eu-west-3:971671216490:subnet/*",
                "arn:aws:ec2:eu-west-3:971671216490:internet-gateway/*",
                "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
                "arn:aws:ec2:eu-west-3:971671216490:security-group/*",
                "arn:aws:ec2:eu-west-3:971671216490:instance/*",
                "arn:aws:ec2:eu-west-3:971671216490:volume/*",
                "arn:aws:ec2:eu-west-3:971671216490:network-interface/*",
                "arn:aws:ec2:eu-west-3::snapshot/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/UgonduCOR": "true",
                    "aws:RequestTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "AllowTaggingDuringCreation",
            "Effect": "Allow",
            "Action": "ec2:CreateTags",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "ec2:CreateAction": [
                        "CreateVpc",
                        "CreateSubnet",
                        "CreateInternetGateway",
                        "CreateRouteTable",
                        "CreateSecurityGroup",
                        "RunInstances",
                        "CreateSnapshot"
                    ],
                    "aws:RequestTag/UgonduCOR": "true",
                    "aws:RequestTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "DenyRemovalOfUgonduOwnershipTags",
            "Effect": "Deny",
            "Action": "ec2:DeleteTags",
            "Resource": [
                "arn:aws:ec2:eu-west-3:971671216490:vpc/*",
                "arn:aws:ec2:eu-west-3:971671216490:subnet/*",
                "arn:aws:ec2:eu-west-3:971671216490:internet-gateway/*",
                "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
                "arn:aws:ec2:eu-west-3:971671216490:security-group/*",
                "arn:aws:ec2:eu-west-3:971671216490:instance/*",
                "arn:aws:ec2:eu-west-3:971671216490:volume/*",
                "arn:aws:ec2:eu-west-3:971671216490:network-interface/*",
                "arn:aws:ec2:eu-west-3::snapshot/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/UgonduCOR": "true"
                }
            }
        },
        {
            "Sid": "AllowRunInstancesReadOnlyResources",
            "Effect": "Allow",
            "Action": "ec2:RunInstances",
            "Resource": [
                "arn:aws:ec2:*::image/*",
                "arn:aws:ec2:*:971671216490:key-pair/*",
                "arn:aws:ec2:*:971671216490:security-group/*",
                "arn:aws:ec2:*:971671216490:subnet/*"
            ]
        },
        {
            "Sid": "EnforceDestructiveBounds",
            "Effect": "Allow",
            "Action": [
                "ec2:DeleteVpc",
                "ec2:DeleteSubnet",
                "ec2:DeleteInternetGateway",
                "ec2:DeleteRouteTable",
                "ec2:DeleteSecurityGroup",
                "ec2:TerminateInstances",
                "ec2:DeleteNetworkInterface",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:ModifyVpcAttribute",
                "ec2:ModifySubnetAttribute",
                "ec2:DeleteSnapshot"
            ],
            "Resource": [
                "arn:aws:ec2:eu-west-3:971671216490:vpc/*",
                "arn:aws:ec2:eu-west-3:971671216490:subnet/*",
                "arn:aws:ec2:eu-west-3:971671216490:internet-gateway/*",
                "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
                "arn:aws:ec2:eu-west-3:971671216490:security-group/*",
                "arn:aws:ec2:eu-west-3:971671216490:instance/*",
                "arn:aws:ec2:eu-west-3:971671216490:network-interface/*",
                "arn:aws:ec2:eu-west-3::snapshot/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/UgonduCOR": "true",
                    "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "AllowAttachDetachGateway",
            "Effect": "Allow",
            "Action": [
                "ec2:AttachInternetGateway",
                "ec2:DetachInternetGateway"
            ],
            "Resource": [
                "arn:aws:ec2:eu-west-3:971671216490:vpc/*",
                "arn:aws:ec2:eu-west-3:971671216490:internet-gateway/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/UgonduCOR": "true",
                    "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "AllowRouteTableAssoc",
            "Effect": "Allow",
            "Action": [
                "ec2:AssociateRouteTable",
                "ec2:DisassociateRouteTable",
                "ec2:CreateRoute",
                "ec2:DeleteRoute"
            ],
            "Resource": [
                "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
                "arn:aws:ec2:eu-west-3:971671216490:subnet/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/UgonduCOR": "true",
                    "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "CreateTransactionTaggedDBInstance",
            "Effect": "Allow",
            "Action": [
                "rds:CreateDBInstance",
                "rds:CreateDBSnapshot"
            ],
            "Resource": [
                "arn:aws:rds:eu-west-3:971671216490:db:*",
                "arn:aws:rds:eu-west-3:971671216490:snapshot:*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/UgonduCOR": "true",
                    "aws:RequestTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "CreateTransactionTaggedDBSubnetGroup",
            "Effect": "Allow",
            "Action": "rds:CreateDBSubnetGroup",
            "Resource": [
                "arn:aws:rds:eu-west-3:971671216490:subgrp:*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/UgonduCOR": "true",
                    "aws:RequestTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "EnforceRDSTransactionDestructiveBounds",
            "Effect": "Allow",
            "Action": [
                "rds:DeleteDBInstance",
                "rds:ModifyDBInstance",
                "rds:DeleteDBSnapshot"
            ],
            "Resource": [
                "arn:aws:rds:eu-west-3:971671216490:db:*",
                "arn:aws:rds:eu-west-3:971671216490:snapshot:*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/UgonduCOR": "true",
                    "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "EnforceRDSSubnetGroupDestructiveBounds",
            "Effect": "Allow",
            "Action": "rds:DeleteDBSubnetGroup",
            "Resource": [
                "arn:aws:rds:eu-west-3:971671216490:subgrp:*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/UgonduCOR": "true",
                    "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
                    "aws:RequestedRegion": "eu-west-3"
                },
                "Null": {
                    "aws:PrincipalTag/UgonduTransactionId": "false"
                }
            }
        },
        {
            "Sid": "EnforceS3BucketOperations",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:PutBucketTagging",
                "s3:DeleteBucket"
            ],
            "Resource": "arn:aws:s3:::ugondu-cor-bucket-*"
        },
        {
            "Sid": "EnforceS3ObjectOperations",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::ugondu-cor-bucket-*/*"
        },
        {
            "Sid": "EnforceECROperations",
            "Effect": "Allow",
            "Action": [
                "ecr:CreateRepository",
                "ecr:DeleteRepository",
                "ecr:BatchCheckLayerAvailability",
                "ecr:CompleteLayerUpload",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
            ],
            "Resource": "arn:aws:ecr:eu-west-3:971671216490:repository/ugondu-cor-fargate-*"
        },
        {
            "Sid": "EnforceECSOperations",
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition",
                "ecs:DeregisterTaskDefinition",
                "ecs:CreateCluster",
                "ecs:DeleteCluster",
                "ecs:CreateService",
                "ecs:UpdateService",
                "ecs:DeleteService"
            ],
            "Resource": [
                "arn:aws:ecs:eu-west-3:971671216490:task-definition/ugondu-cor-fargate-*",
                "arn:aws:ecs:eu-west-3:971671216490:cluster/ugondu-cor-fargate-*",
                "arn:aws:ecs:eu-west-3:971671216490:service/ugondu-cor-fargate-*/*"
            ]
        },
        {
            "Sid": "AllowPassRoleForECS",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::971671216490:role/ecsTaskExecutionRole",
            "Condition": {
                "StringLike": {
                    "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
            }
        },
        {
            "Sid": "AllowGlobalReadDiscovery",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeVpcs",
                "ec2:DescribeSubnets",
                "ec2:DescribeInternetGateways",
                "ec2:DescribeRouteTables",
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeInstances",
                "ec2:DescribeNetworkInterfaces",
                "ec2:DescribeTags",
                "ec2:DescribeSnapshots",
                "rds:DescribeDBInstances",
                "rds:DescribeDBSubnetGroups",
                "rds:DescribeDBSnapshots",
                "rds:ListTagsForResource",
                "s3:HeadBucket",
                "ecr:DescribeRepositories",
                "ecr:GetAuthorizationToken",
                "ecs:DescribeTaskDefinition",
                "ecs:DescribeServices",
                "ecs:DescribeClusters"
            ],
            "Resource": "*"
        }
    ]
}
