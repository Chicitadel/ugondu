{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugondu.airroofers.eu/schemas/discovery.v1.json",
  "title": "DiscoveryResult",
  "description": "Canonical Discovery Result Schema v1.0.0",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "repositoryUrl",
    "branch",
    "detectedLanguages",
    "frameworks",
    "packageManagers",
    "entrypoints",
    "exposedPorts",
    "discoveredServices",
    "hasDockerfile",
    "existingCI"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0"] },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "branch": { "type": "string", "minLength": 1 },
    "detectedLanguages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "frameworks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "packageManagers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entrypoints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exposedPorts": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "discoveredServices": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hasDockerfile": { "type": "boolean" },
    "existingCI": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
