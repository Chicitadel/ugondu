{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugondu.airroofers.eu/schemas/envelope.v1.json",
  "title": "ExecutionEnvelope",
  "description": "Canonical Ugondu Execution Envelope Schema v1.0.0",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "protocolVersion",
    "transactionId",
    "executionId",
    "nonce",
    "issuedAt",
    "expiresAt",
    "issuer",
    "keyId",
    "tenantId",
    "projectId",
    "environmentId",
    "workspaceId",
    "targetId",
    "agentId",
    "agentVersion",
    "edition",
    "planHash",
    "policyHash",
    "artifactDigest",
    "capabilities"
  ],
  "properties": {
    "protocolVersion": { "type": "string", "enum": ["1.0.0", "1.2.0", "2.0.0"] },
    "transactionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 16 },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 },
    "issuer": { "type": "string", "minLength": 1 },
    "keyId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "environmentId": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "targetId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "agentVersion": { "type": "string", "minLength": 1 },
    "edition": { "type": "string", "enum": ["community", "professional", "business", "enterprise", "sovereign"] },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "capabilities": { "type": "object" },
    "steps": { "type": "array" },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
