{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugondu.airroofers.eu/schemas/state.v1.json",
  "title": "ExecutionState",
  "description": "Canonical Ugondu Durable Execution State Schema v1.0.0",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "transactionId",
    "executionId",
    "tenantId",
    "projectId",
    "environmentId",
    "workspaceId",
    "targetId",
    "planHash",
    "policyHash",
    "status",
    "stateSequence",
    "stateHash",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "transactionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "environmentId": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "targetId": { "type": "string", "minLength": 1 },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recipeSignature": { "type": "string" },
    "agentId": { "type": "string" },
    "agentVersion": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "DISCOVERING",
        "PLANNED",
        "SIMULATED",
        "WAITING_APPROVAL",
        "APPROVED",
        "RUNNING",
        "VERIFYING",
        "SUCCESS",
        "FAILED",
        "ROLLING_BACK",
        "ROLLED_BACK",
        "RECOVERY_REQUIRED",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "stateSequence": { "type": "integer", "minimum": 0 },
    "stateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previousStateHash": { "type": "string" },
    "createdAt": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 },
    "steps": { "type": "array" },
    "context": { "type": "object" }
  },
  "additionalProperties": false
}
