{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugondu.airroofers.eu/schemas/project_model.v1.json",
  "title": "UniversalProjectModel",
  "description": "Canonical Universal Project Model (UPM) Multi-Graph Schema v1.0.0",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "projectName",
    "components",
    "dependencies",
    "services",
    "infrastructure",
    "policies"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0"] },
    "projectId": { "type": "string", "minLength": 1 },
    "projectName": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "runtime"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "runtime": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string" }
        }
      }
    },
    "services": {
      "type": "array",
      "items": { "type": "string" }
    },
    "infrastructure": {
      "type": "object",
      "required": ["targetEnvironment"],
      "properties": {
        "targetEnvironment": { "type": "string" }
      }
    },
    "policies": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
