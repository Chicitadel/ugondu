{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugondu.airroofers.eu/schemas/actions.v1.json",
  "title": "TypedActions",
  "description": "Canonical Ugondu Closed-World Typed Actions Schema v1.0.0",
  "version": "1.0.0",
  "definitions": {
    "FETCH_REPOSITORY": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SYNC_ENVIRONMENT": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "type": "string", "enum": ["quota-sync", "atomic"] }
      },
      "additionalProperties": false
    },
    "PRUNE_RELEASES": {
      "type": "object",
      "required": ["retention"],
      "properties": {
        "retention": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "UPSELL_NOTICE": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "NODE_INSTALL": {
      "type": "object",
      "properties": {
        "packageManager": { "type": "string", "enum": ["npm", "yarn", "pnpm"] },
        "lockfile": { "type": "string" },
        "workingDirectory": { "type": "string" },
        "production": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 100 }
      },
      "additionalProperties": false
    },
    "COMPOSER_INSTALL": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "enum": ["install", "update", "dump-autoload"] },
        "noDev": { "type": "boolean" },
        "optimizeAutoloader": { "type": "boolean" },
        "workingDirectory": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 100 }
      },
      "additionalProperties": false
    },
    "COPY_FILE": {
      "type": "object",
      "required": ["source", "destination"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 },
        "mode": { "type": "string" },
        "overwrite": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "CREATE_DIRECTORY": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SYMLINK": {
      "type": "object",
      "required": ["target", "linkName"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "linkName": { "type": "string", "minLength": 1 },
        "relative": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "SERVICE_RESTART": {
      "type": "object",
      "required": ["service"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "strategy": { "type": "string", "enum": ["graceful", "immediate", "reload"] },
        "timeoutMs": { "type": "integer", "minimum": 100 }
      },
      "additionalProperties": false
    }
  }
}
