# =============================================================================
# Ugondu Engine Core - Docker Container
# Air Roofers Ltd
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy monorepo workspace configurations
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# Copy packages
COPY server ./server

# Install dependencies and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ugondu/engine-core build

# =============================================================================
# Production Environment
# =============================================================================
FROM node:20-alpine

WORKDIR /usr/src/app

ENV NODE_ENV=production

# Copy built engine core
COPY --from=builder /usr/src/app/server/engine-core/dist ./dist
COPY --from=builder /usr/src/app/server/engine-core/package.json ./

# Install only production dependencies
RUN npm install --omit=dev

# Execute as non-root user for security
RUN addgroup -S ugondu && adduser -S ugondu -G ugondu
USER ugondu

EXPOSE 8080

CMD ["node", "dist/index.js"]
