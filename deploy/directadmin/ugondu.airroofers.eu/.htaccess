# /******************************************************************************
#  * Project        : Ugondu Platform
#  * Module         : DirectAdmin / Apache Web Routing & Hardening Gateway
#  * Domain         : ugondu.airroofers.eu
#  * Classification : ENTERPRISE | PUBLIC WEB HOSTING
#  * Author         : Ignatus Chika Ujomor <systems@airroofers.eu>
#  * Organization   : Air Roofers SASU
#  * Standards      : ISO 27001 / OWASP ASVS / RFC 9110
#  ******************************************************************************/

# 1. 🛡️ Disable Passenger (CRITICAL: Prevents DirectAdmin HTTP 500 error on static SPAs)
<IfModule mod_passenger.c>
  PassengerEnabled off
</IfModule>

# 2. 📄 Directory Index
DirectoryIndex index.html index.php

# 3. 📦 MIME Type Configuration
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# 4. 🔒 Enterprise Security & CORS Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD"
  Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-Ugondu-Token, X-Mandatag-Key"
</IfModule>

# 5. 🚀 High-Performance Caching & SPA Expiration
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. 🔁 Single Page Application (SPA) Deep-Link URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [QSA,L]
</IfModule>

# 7. 🚫 Protect Sensitive & Hidden Files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
