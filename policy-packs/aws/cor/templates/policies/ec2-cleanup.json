{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRemovalOfUgonduOwnershipTags",
      "Effect": "Deny",
      "Action": "ec2:DeleteTags",
      "Resource": [
        "arn:aws:ec2:eu-west-3:971671216490:vpc/*",
        "arn:aws:ec2:eu-west-3:971671216490:subnet/*",
        "arn:aws:ec2:eu-west-3:971671216490:internet-gateway/*",
        "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
        "arn:aws:ec2:eu-west-3:971671216490:security-group/*",
        "arn:aws:ec2:eu-west-3:971671216490:instance/*",
        "arn:aws:ec2:eu-west-3:971671216490:volume/*",
        "arn:aws:ec2:eu-west-3:971671216490:network-interface/*",
        "arn:aws:ec2:eu-west-3::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true"
        }
      }
    },
    {
      "Sid": "EnforceDeleteVpc",
      "Effect": "Allow",
      "Action": "ec2:DeleteVpc",
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "EnforceDeleteSubnet",
      "Effect": "Allow",
      "Action": "ec2:DeleteSubnet",
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "EnforceDeleteInternetGateway",
      "Effect": "Allow",
      "Action": "ec2:DeleteInternetGateway",
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:internet-gateway/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "EnforceDeleteRouteTable",
      "Effect": "Allow",
      "Action": "ec2:DeleteRouteTable",
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "EnforceDeleteSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "EnforceTerminateInstances",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "EnforceDeleteNetworkInterface",
      "Effect": "Allow",
      "Action": "ec2:DeleteNetworkInterface",
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "EnforceDeleteSnapshot",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:eu-west-3::snapshot/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "AllowAttachDetachGateway",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway"
      ],
      "Resource": [
        "arn:aws:ec2:eu-west-3:971671216490:vpc/*",
        "arn:aws:ec2:eu-west-3:971671216490:internet-gateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "AllowRouteTableAssoc",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
        "arn:aws:ec2:eu-west-3:971671216490:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    },
    {
      "Sid": "AllowRouteOps",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRoute",
        "ec2:DeleteRoute"
      ],
      "Resource": "arn:aws:ec2:eu-west-3:971671216490:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/UgonduCOR": "true",
          "aws:ResourceTag/UgonduTransactionId": "${aws:PrincipalTag/UgonduTransactionId}",
          "aws:RequestedRegion": "eu-west-3"
        },
        "Null": {
          "aws:PrincipalTag/UgonduTransactionId": "false"
        }
      }
    }
  ]
}
