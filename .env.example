# [en] Ephemeral or KMS-injected Ed25519 signing key material for execution recipes (base64/PEM via secret manager)
UGONDU_RECIPE_PRIVATE_KEY=

# [en] External KMS / HSM key reference URI for recipe and attestation signing
UGONDU_KEY_REF=kms://airroofers-ugondu/recipe-signing-key

# [en] Legacy signing key variable alias (leave blank in repository; inject at runtime only if required)
UGONDU_PRIVATE_KEY=

# [en] Strict CORS allowlist for HTTP API gateways (comma-separated origins)
ALLOWED_ORIGINS=https://console.airroofers.eu,https://ugondu.airroofers.eu

# [en] Identity Authority endpoint (Air Roofers SSO)
IDENTITY_AUTHORITY_URL=https://identity.airroofers.eu/api/v1

# [en] Billing Authority endpoint (AeroBill)
BILLING_AUTHORITY_URL=https://billing.airroofers.eu/api/v1
