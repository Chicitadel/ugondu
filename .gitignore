# [en] Node.js artifacts
node_modules/
dist/
*.js.map

# [en] Go build artifacts
client/ugondu
client/ugondu.exe

# [en] Environment secrets
.env
*_private.pem
**/*_private.pem
server/engine-core/keys/*.pem

# [en] Logs
*.log

# [en] OS artifacts
.DS_Store
Thumbs.db

# [en] Server runtime datastores
server/data/
.service_replay_ledger.json
**/.service_replay_ledger.json

# [en] COR evidence is generated as an external CI/local artifact, never committed
cor-evidence-bundle.json
cor-test-results.json
.cor_evidence/

# [en] Local engineering tooling, scratch scripts, and temporary dumps (never shipped)
scratch/
**/scratch/
.governance/tmp/
scratch_*
git-grep.txt
grep-ts.txt
out.txt
prod_search_*.txt
repo_tree.txt
search_results*
filtered_search.json
sync_files.txt
target_search.json
tree.txt
*.zip

# Runtime passport store data (never commit)
var/data/
